# Local PostgreSQL started with `docker compose up -d db`.
# Export these variables before starting Python; no automatic .env loading.
APP_ENV=development
AUTH_PROVIDER=local
DATABASE_URL=postgresql://starter_api:starter-local-api-only@127.0.0.1:55439/starter
# Schema-owner credentials are for the migration job only; never give them to the web service.
DATABASE_ADMIN_URL=postgresql://starter_owner:starter-local-only@127.0.0.1:55439/starter
DB_POOL_MAX_SIZE=4
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
TERMS_VERSION=starter-v1
PRIVACY_VERSION=starter-v1
# Firebase profile: AUTH_PROVIDER=firebase (legacy google alias also works).
# Use Application Default Credentials or your hosting platform identity, never a committed key.
# Optional GOOGLE_PROJECT_ID with AUTH_PROVIDER=firebase.
# GOOGLE_PROJECT_ID=your-project
# APP_STATIC_DIR=../frontend/dist

# Optional Claude Agent SDK read-only demo. Keep the real key server-side only.
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Optional validated overrides (defaults shown; keep low while testing).
AGENT_MAX_TURNS=4
AGENT_MAX_BUDGET_USD=0.05
AGENT_MAX_OUTPUT_TOKENS=768
AGENT_MAX_MESSAGE_CHARS=1000
AGENT_REQUEST_TIMEOUT_SECONDS=90
AGENT_ACTION_TIMEOUT_SECONDS=15
AGENT_MAX_CONCURRENT_RUNS=4
# Optional plan checks. False preserves existing features; roles still apply.
BILLING_ENABLED=false
# Operator CLI only. Never give this credential to the web server or browser.
# PLAN_OPERATOR_DATABASE_URL=postgresql://trusted_operator:...@localhost:55439/starter
# Optional Stripe subscriptions: install backend extra `billing`. Never put secrets in VITE_*.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_ALLOW_LIVE=false
# APP_PUBLIC_URL=http://localhost:5173
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Separate restricted login granted only app_billing_service; not the migration owner/runtime login.
# BILLING_DATABASE_URL=postgresql://billing_service:...@localhost:55439/starter
# STRIPE_PORTAL_CONFIGURATION=bpc_...

# Optional platform settings (verified subject IDs; only owners control deployment config).
# PLATFORM_OWNER_SUBJECTS=verified-owner-subject
# PLATFORM_ADMIN_SUBJECTS=verified-admin-subject
# Separate login granted only app_plan_editor; omission keeps the catalog read-only.
# PLATFORM_DATABASE_URL=postgresql://starter_plan_editor:...@localhost:55439/starter

# Manual feedback triage (server-only; independent of the demo chat toggle).
TRIAGE_ENABLED=false
TRIAGE_MODEL=claude-haiku-5-5
# Reuses ANTHROPIC_API_KEY from the private server environment; never VITE_*.
