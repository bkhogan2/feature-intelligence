# Frontend (public build-time values). Blank base URL uses the Vite /api proxy.
VITE_API_BASE_URL=
VITE_AUTH_PROVIDER=local
# Firebase profile: set VITE_AUTH_PROVIDER=firebase (legacy google alias also works).
# These are public Firebase web settings, not server credentials.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_AUTH_DOMAIN=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_PROJECT_ID=
# Replace the development policy pages for each real application.
VITE_TERMS_URL=/terms.html
VITE_PRIVACY_URL=/privacy.html

# Local development proxy; deployed apps use VITE_API_BASE_URL.
DEV_API_TARGET=http://127.0.0.1:8000
